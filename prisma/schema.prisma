generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model abouts {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title            String
  slug             String?
  description      String?   @db.LongText
  status           Boolean   @default(true)
  meta_title       String?   @db.Text
  meta_keywords    String?   @db.Text
  meta_description String?   @db.Text
  schema_code      String?   @db.Text
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)
}

model adminquotedetails {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  adminquote_id BigInt      @db.UnsignedBigInt
  name          String
  price         Decimal     @db.Decimal(8, 2)
  type          String      @default("labour")
  created_at    DateTime?   @db.Timestamp(0)
  updated_at    DateTime?   @db.Timestamp(0)
  adminquotes   adminquotes @relation(fields: [adminquote_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "adminquotedetails_adminquote_id_foreign")

  @@index([adminquote_id], map: "adminquotedetails_adminquote_id_foreign")
}

model adminquotes {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  order_id          BigInt              @db.UnsignedBigInt
  price             Decimal?            @db.Decimal(8, 2)
  status            String              @default("unsent")
  saved             String              @default("no")
  notes             String?             @db.Text
  created_at        DateTime?           @db.Timestamp(0)
  updated_at        DateTime?           @db.Timestamp(0)
  adminquotedetails adminquotedetails[]
  orders            orders              @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "adminquotes_order_id_foreign")

  @@index([order_id], map: "adminquotes_order_id_foreign")
}

model adminresolutions {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  order_id   BigInt    @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  sender     String
  message    String?   @db.Text
  file_type  String?
  file       String?   @db.LongText
  seen       Boolean   @default(false)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  orders     orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "adminresolutions_order_id_foreign")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "adminresolutions_user_id_foreign")

  @@index([order_id], map: "adminresolutions_order_id_foreign")
  @@index([user_id], map: "adminresolutions_user_id_foreign")
}

model admins {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  role               String    @default("admin")
  name               String
  email              String    @unique(map: "admins_email_unique")
  profile_photo_path String?   @db.Text
  password           String
  remember_token     String?   @db.VarChar(100)
  created_at         DateTime? @db.Timestamp(0)
  updated_at         DateTime? @db.Timestamp(0)
}

model assignexcuses {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  orderassign_id BigInt       @db.UnsignedBigInt
  user_id        BigInt       @db.UnsignedBigInt
  reason         String       @db.Text
  created_at     DateTime?    @db.Timestamp(0)
  updated_at     DateTime?    @db.Timestamp(0)
  orderassigns   orderassigns @relation(fields: [orderassign_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignexcuses_orderassign_id_foreign")
  users          users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignexcuses_user_id_foreign")

  @@index([orderassign_id], map: "assignexcuses_orderassign_id_foreign")
  @@index([user_id], map: "assignexcuses_user_id_foreign")
}

model assignfaults {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  orderassign_id BigInt       @db.UnsignedBigInt
  description    String       @db.Text
  urgency        String
  trouble_code   String?
  fixed          Boolean      @default(false)
  created_at     DateTime?    @db.Timestamp(0)
  updated_at     DateTime?    @db.Timestamp(0)
  orderassigns   orderassigns @relation(fields: [orderassign_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignfaults_orderassign_id_foreign")

  @@index([orderassign_id], map: "assignfaults_orderassign_id_foreign")
}

model assignfiles {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  orderassign_id BigInt       @db.UnsignedBigInt
  description    String?      @db.Text
  image          String
  created_at     DateTime?    @db.Timestamp(0)
  updated_at     DateTime?    @db.Timestamp(0)
  orderassigns   orderassigns @relation(fields: [orderassign_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignfiles_orderassign_id_foreign")

  @@index([orderassign_id], map: "assignfiles_orderassign_id_foreign")
}

model assignlabours {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  orderassign_id BigInt       @db.UnsignedBigInt
  description    String?      @db.Text
  labour         Decimal      @db.Decimal(8, 2)
  created_at     DateTime?    @db.Timestamp(0)
  updated_at     DateTime?    @db.Timestamp(0)
  orderassigns   orderassigns @relation(fields: [orderassign_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignlabours_orderassign_id_foreign")

  @@index([orderassign_id], map: "assignlabours_orderassign_id_foreign")
}

model assignparts {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  orderassign_id BigInt       @db.UnsignedBigInt
  description    String?      @db.Text
  price          Decimal      @db.Decimal(8, 2)
  created_at     DateTime?    @db.Timestamp(0)
  updated_at     DateTime?    @db.Timestamp(0)
  orderassigns   orderassigns @relation(fields: [orderassign_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignparts_orderassign_id_foreign")

  @@index([orderassign_id], map: "assignparts_orderassign_id_foreign")
}

model assignserviceparts {
  id               BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  assignservice_id BigInt         @db.UnsignedBigInt
  name             String
  price            Decimal        @db.Decimal(8, 2)
  created_at       DateTime?      @db.Timestamp(0)
  updated_at       DateTime?      @db.Timestamp(0)
  assignservices   assignservices @relation(fields: [assignservice_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignserviceparts_assignservice_id_foreign")

  @@index([assignservice_id], map: "assignserviceparts_assignservice_id_foreign")
}

model assignservices {
  id                 BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  orderassign_id     BigInt               @db.UnsignedBigInt
  name               String
  labour             Decimal              @db.Decimal(8, 2)
  created_at         DateTime?            @db.Timestamp(0)
  updated_at         DateTime?            @db.Timestamp(0)
  assignserviceparts assignserviceparts[]
  orderassigns       orderassigns         @relation(fields: [orderassign_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assignservices_orderassign_id_foreign")

  @@index([orderassign_id], map: "assignservices_orderassign_id_foreign")
}

model bespokelabours {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  bespoke_id BigInt    @db.UnsignedBigInt
  name       String
  hour       String
  price      Decimal   @db.Decimal(8, 2)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  bespokes   bespokes  @relation(fields: [bespoke_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bespokelabours_bespoke_id_foreign")

  @@index([bespoke_id], map: "bespokelabours_bespoke_id_foreign")
}

model bespokeparts {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  bespoke_id BigInt    @db.UnsignedBigInt
  name       String
  price      Decimal   @db.Decimal(8, 2)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  bespokes   bespokes  @relation(fields: [bespoke_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bespokeparts_bespoke_id_foreign")

  @@index([bespoke_id], map: "bespokeparts_bespoke_id_foreign")
}

model bespokes {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  user_id         BigInt            @db.UnsignedBigInt
  postcode        String?
  status          String            @default("pending")
  price           Decimal           @default(0.00) @db.Decimal(8, 2)
  car_data        String            @db.LongText
  token           String?
  service         String?           @db.Text
  created_at      DateTime?         @db.Timestamp(0)
  updated_at      DateTime?         @db.Timestamp(0)
  bespokelabours  bespokelabours[]
  bespokeparts    bespokeparts[]
  users           users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bespokes_user_id_foreign")
  bespokeservices bespokeservices[]
  bespokeusers    bespokeusers[]

  @@index([user_id], map: "bespokes_user_id_foreign")
}

model bespokeservices {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  bespoke_id BigInt    @db.UnsignedBigInt
  service_id BigInt    @db.UnsignedBigInt
  price      Decimal?  @db.Decimal(8, 2)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  bespokes   bespokes  @relation(fields: [bespoke_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bespokeservices_bespoke_id_foreign")
  services   services  @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bespokeservices_service_id_foreign")

  @@index([bespoke_id], map: "bespokeservices_bespoke_id_foreign")
  @@index([service_id], map: "bespokeservices_service_id_foreign")
}

model bespokeusers {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  bespoke_id BigInt    @db.UnsignedBigInt
  fname      String?
  lname      String?
  email      String
  phone      String?
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  bespokes   bespokes  @relation(fields: [bespoke_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bespokeusers_bespoke_id_foreign")

  @@index([bespoke_id], map: "bespokeusers_bespoke_id_foreign")
}

model blog_tag {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tag_id     BigInt
  blog_id    BigInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model blogcategories {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  title             String
  slug              String              @unique(map: "blogcategories_slug_unique")
  description       String?             @db.LongText
  status            Boolean             @default(true)
  created_at        DateTime?           @db.Timestamp(0)
  updated_at        DateTime?           @db.Timestamp(0)
  blogs             blogs[]
  blogsubcategories blogsubcategories[]
}

model blogfiles {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  blog_id    BigInt
  pic        String
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model blogimages {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  image      String
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model blogs {
  id                          BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  blogcategory_id             BigInt         @db.UnsignedBigInt
  blogsubcategory_id          BigInt         @default(0)
  author                      String?        @db.VarChar(255)
  title                       String         @db.Text
  slug                        String         @unique(map: "blogs_slug_unique")
  description                 String?        @db.LongText
  feature_image               String?        @db.Text
  feature_image_alertnative   String?        @db.Text
  thumbnail_image             String?        @db.Text
  thumbnail_image_alertnative String?        @db.Text
  meta_title                  String?        @db.Text
  meta_keywords               String?        @db.Text
  meta_description            String?        @db.Text
  schema_code                 String?        @db.Text
  status                      Boolean        @default(true)
  views                       BigInt         @default(0)
  created_at                  DateTime?      @db.Timestamp(0)
  updated_at                  DateTime?      @db.Timestamp(0)
  blogcategories              blogcategories @relation(fields: [blogcategory_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "blogs_blogcategory_id_foreign")

  @@index([blogcategory_id], map: "blogs_blogcategory_id_index")
}

model blogsubcategories {
  id              BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  blogcategory_id BigInt         @db.UnsignedBigInt
  title           String
  slug            String         @unique(map: "blogsubcategories_slug_unique")
  description     String?        @db.LongText
  status          Boolean        @default(true)
  created_at      DateTime?      @db.Timestamp(0)
  updated_at      DateTime?      @db.Timestamp(0)
  blogcategories  blogcategories @relation(fields: [blogcategory_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "blogsubcategories_blogcategory_id_foreign")

  @@index([blogcategory_id], map: "blogsubcategories_blogcategory_id_foreign")
}

model carprices {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  car        String    @db.LongText
  name       String
  type       String    @default("part")
  value      Decimal   @default(0.00) @db.Decimal(8, 2)
  status     String    @default("pending")
  source     String    @default("Admin Quote")
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model cars {
  id           BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  oil_capacity Decimal        @default(5.00) @db.Decimal(8, 2)
  coil_pack    Int?           @default(1)
  spark_plug   Int?           @default(4)
  glow_plug    Int?           @default(4)
  status       Boolean?       @default(true)
  source       String?
  created_at   DateTime?      @db.Timestamp(0)
  updated_at   DateTime?      @db.Timestamp(0)
  make         String
  model        String
  fuel         String
  engine       String
  year         String
  labours      labours[]
  vehicledatas vehicledatas[]
}

model cartdatas {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  order_id   BigInt    @db.UnsignedBigInt
  data       String?   @db.LongText
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  orders     orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cartdatas_order_id_foreign")

  @@index([order_id], map: "cartdatas_order_id_foreign")
}

model category_user {
  id              BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  user_id         BigInt         @db.UnsignedBigInt
  maincategory_id BigInt         @db.UnsignedBigInt
  created_at      DateTime?      @db.Timestamp(0)
  updated_at      DateTime?      @db.Timestamp(0)
  maincategories  maincategories @relation(fields: [maincategory_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "category_user_maincategory_id_foreign")
  users           users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "category_user_user_id_foreign")

  @@index([maincategory_id], map: "category_user_maincategory_id_foreign")
  @@index([user_id], map: "category_user_user_id_foreign")
}

model cities {
  id              BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  county_id       BigInt      @db.UnsignedBigInt
  name            String
  slug            String      @unique(map: "cities_slug_unique")
  labour_rate     Decimal     @default(60.00) @db.Decimal(8, 2)
  description     String?     @db.LongText
  page_title      String?
  seo_keywords    String?     @db.Text
  seo_description String?     @db.Text
  schema_code     String?     @db.Text
  created_at      DateTime?   @db.Timestamp(0)
  updated_at      DateTime?   @db.Timestamp(0)
  counties        counties    @relation(fields: [county_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cities_county_id_foreign")
  postcodes       postcodes[]

  @@index([county_id], map: "cities_county_id_foreign")
}

model contacts {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String?
  email      String
  phone      String?
  subject    String?
  message    String?   @db.Text
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model counties {
  id         BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  name       String
  created_at DateTime?   @db.Timestamp(0)
  updated_at DateTime?   @db.Timestamp(0)
  cities     cities[]
  postcodes  postcodes[]
}

model docmails {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  subject     String
  description String?   @db.LongText
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model documents {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  type        String
  mandatory   Boolean       @default(true)
  name        String
  created_at  DateTime?     @db.Timestamp(0)
  updated_at  DateTime?     @db.Timestamp(0)
  requiredocs requiredocs[]
}

model editors {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name               String
  email              String    @unique(map: "editors_email_unique")
  profile_photo_path String?   @db.Text
  password           String
  remember_token     String?   @db.VarChar(100)
  created_at         DateTime? @db.Timestamp(0)
  updated_at         DateTime? @db.Timestamp(0)
}

model emailfiles {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  type       String?
  email_id   BigInt    @db.UnsignedBigInt
  src        String    @db.Text
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  emails     emails    @relation(fields: [email_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "emailfiles_email_id_foreign")

  @@index([email_id], map: "emailfiles_email_id_index")
}

model emails {
  id         BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  subject    String?      @db.Text
  to         String       @db.Text
  message    String?      @db.LongText
  created_at DateTime?    @db.Timestamp(0)
  updated_at DateTime?    @db.Timestamp(0)
  emailfiles emailfiles[]
}

model emailtemplates {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  image      String
  template   String    @db.LongText
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model engines {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  fuel_id    BigInt    @db.UnsignedBigInt
  name       Decimal   @default(0.00) @db.Decimal(8, 2)
  status     Boolean?  @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  fuels      fuels     @relation(fields: [fuel_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "engines_fuel_id_foreign")
  years      years[]

  @@index([fuel_id], map: "engines_fuel_id_foreign")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model faqs {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title       String    @db.Text
  description String    @db.Text
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model fuels {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  modal_id   BigInt    @db.UnsignedBigInt
  fuel       String
  status     Boolean   @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  engines    engines[]
  modals     modals    @relation(fields: [modal_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fuels_modal_id_foreign")

  @@index([modal_id], map: "fuels_modal_id_foreign")
}

model jobs {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  queue        String
  payload      String @db.LongText
  attempts     Int    @db.UnsignedTinyInt
  reserved_at  Int?   @db.UnsignedInt
  available_at Int    @db.UnsignedInt
  created_at   Int    @db.UnsignedInt

  @@index([queue], map: "jobs_queue_index")
}

model labours {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  service_id  BigInt    @db.UnsignedBigInt
  car_id      BigInt    @db.UnsignedBigInt
  labour_rate Decimal   @default(60.00) @db.Decimal(8, 2)
  labour_hour Decimal   @db.Decimal(8, 2)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  cars        cars      @relation(fields: [car_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "labours_car_id_foreign")
  services    services  @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "labours_service_id_foreign")

  @@index([car_id], map: "labours_car_id_foreign")
  @@index([service_id], map: "labours_service_id_foreign")
}

model maincategories {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  title             String
  slug              String              @unique(map: "maincategories_slug_unique")
  icon              String?
  description       String?             @db.LongText
  status            Boolean             @default(true)
  created_at        DateTime?           @db.Timestamp(0)
  updated_at        DateTime?           @db.Timestamp(0)
  category_user     category_user[]
  mainsubcategories mainsubcategories[]
  servicepages      servicepages[]
  services          services[]
}

model mainsubcategories {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  maincategory_id      BigInt                 @db.UnsignedBigInt
  title                String
  slug                 String                 @unique(map: "mainsubcategories_slug_unique")
  description          String?                @db.LongText
  status               Boolean                @default(true)
  created_at           DateTime?              @db.Timestamp(0)
  updated_at           DateTime?              @db.Timestamp(0)
  maincategories       maincategories         @relation(fields: [maincategory_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "mainsubcategories_maincategory_id_foreign")
  mainsubsubcategories mainsubsubcategories[]

  @@index([maincategory_id], map: "mainsubcategories_maincategory_id_foreign")
}

model mainsubsubcategories {
  id                 BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  mainsubcategory_id BigInt            @db.UnsignedBigInt
  title              String
  slug               String            @unique(map: "mainsubsubcategories_slug_unique")
  description        String?           @db.LongText
  status             Boolean           @default(true)
  created_at         DateTime?         @db.Timestamp(0)
  updated_at         DateTime?         @db.Timestamp(0)
  mainsubcategories  mainsubcategories @relation(fields: [mainsubcategory_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "mainsubsubcategories_mainsubcategory_id_foreign")

  @@index([mainsubcategory_id], map: "mainsubsubcategories_mainsubcategory_id_foreign")
}

model makepages {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  make_id          BigInt    @db.UnsignedBigInt
  detail           String?   @db.LongText
  page_title       String?   @db.Text
  page_keywords    String?   @db.Text
